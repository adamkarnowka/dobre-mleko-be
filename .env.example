DATABASE_URL=postgres://mleko:mleko@localhost:5432/mleko
# Google accounts allowed to sign in, comma-separated.
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
# OAuth client IDs of the apps (iOS, Android, web) whose Google ID tokens are accepted.
GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com
# openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# Where photo files are stored.
PHOTO_DIR=./data/photos
# Sign in without Google via POST /auth/dev (ignored when NODE_ENV=production).
DEV_LOGIN=true
