DATABASE_URL=postgres://mleko:mleko@localhost:5432/mleko
# Admins, comma-separated. Always on the whitelist; everyone else is added in the admin dashboard (/admin/).
ADMIN_EMAILS=you@gmail.com
# OAuth client IDs of the mobile apps (iOS, Android) whose Google ID tokens are accepted.
GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com
# OAuth client ID of type "Web application" for the dashboard's Google sign-in button.
GOOGLE_WEB_CLIENT_ID=
# openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# Where photo files are stored.
PHOTO_DIR=./data/photos
# Sign in without Google via POST /auth/dev (ignored when NODE_ENV=production).
DEV_LOGIN=true
