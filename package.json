{
  "name": "dobre-mleko-be",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Dobre Mleko — place ratings for friends only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate-cli.ts",
    "migrate:prod": "node dist/migrate-cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx src/openapi.ts",
    "format": "prettier --write src test admin",
    "format:check": "prettier --check src test admin",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "google-auth-library": "^11.2.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
